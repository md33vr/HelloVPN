{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hello!",
  "mainBinaryName": "Hello",
  "version": "0.2.2",
  "identifier": "friends.hello.vpn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Hello! friends",
    "copyright": "Hello! — между друзьями",
    "shortDescription": "VPN-клиент для Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../bin/sing-box.exe": "bin/sing-box.exe",
      "../bin/libcronet.dll": "bin/libcronet.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Hello!"
      }
    }
  }
}
